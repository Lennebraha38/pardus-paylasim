<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1"/>
  <object class="AdwApplicationWindow" id="main_window">
    <property name="title" translatable="yes">Pardus Güvenli Paylaşım ve Süreklilik Merkezi</property>
    <property name="default-width">1000</property>
    <property name="default-height">720</property>
    <property name="content">
      <object class="GtkBox" id="main_box">
        <property name="orientation">vertical</property>
        <child>
          <object class="AdwHeaderBar" id="header_bar">
            <child type="title">
              <object class="AdwViewSwitcherTitle" id="view_switcher_title">
                <property name="title" translatable="yes">Pardus Paylaşım</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwViewStack" id="view_stack">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
