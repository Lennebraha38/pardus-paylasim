FROM pardus/yirmiuc@sha256:48c81e9c1c8ae80254cff28f846afdde6384adf8665f4dfdbd7894240bf9e141

# Temel paketler ve X11/GTK bağımlılıkları (Pardus 21/23 uyumluluğu için Bullseye/Bookworm benzerliği)
RUN apt-get update && apt-get install -y \
    python3 python3-pip xvfb x11-utils dbus-x11 \
    libgirepository1.0-dev libcairo2-dev pkg-config python3-gi python3-gi-cairo gir1.2-gtk-4.0 gir1.2-adw-1 \
    libnss3-tools iputils-ping \
    && rm -rf /var/lib/apt/lists/*

COPY . /app
WORKDIR /app

# aiortc ve sistem bağımlılıkları için ekstra derleme araçları
RUN apt-get update && apt-get install -y gcc g++ python3-dev libavdevice-dev libavfilter-dev libopus-dev libvpx-dev
RUN pip3 install --break-system-packages --upgrade pip && pip3 install --break-system-packages --no-cache-dir . pytest requests websockets

# Xvfb ortamında başsız (headless) çalıştırma
ENV DISPLAY=:99
CMD Xvfb :99 -screen 0 1920x1080x24 -ac & \
    sleep 2 && \
    python3 src/pardus_paylasim/app.py & \
    tail -f /dev/null
